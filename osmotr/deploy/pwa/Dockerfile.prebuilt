# «Осмотр» PWA — образ из уже собранной папки (GitLab: задача build:pwa собирает с кэшем Gradle, эта — только
# упаковывает). Перед сборкой образа папка сборки кладётся в корень контекста как pwa-dist/:
#   cp -r shared/build/dist/wasmJs/productionExecutable pwa-dist
#   docker build -f deploy/pwa/Dockerfile.prebuilt -t osmotr-pwa .
# Слой раздачи — тот же, что в deploy/pwa/Dockerfile (правите один — правьте и другой).
FROM nginxinc/nginx-unprivileged:1.28-alpine
COPY deploy/pwa/osmotr-pwa.conf /etc/nginx/osmotr-pwa.conf
COPY deploy/pwa/container.conf /etc/nginx/conf.d/default.conf
# Владелец — сразу при копировании (отдельный chown удвоил бы слой); .map не попадают (.dockerignore).
COPY --chown=101:101 pwa-dist/ /usr/share/nginx/html/
# Сжать заранее (gzip_static): .wasm, .js, .css, манифест, шрифты.
RUN find /usr/share/nginx/html -type f \( -name '*.wasm' -o -name '*.js' -o -name '*.css' -o -name '*.webmanifest' -o -name '*.ttf' \) \
      -exec gzip -9 -k -n {} \;
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
