{
  "name": "inside",
  "version": "1.0.0",
  "private": true,
  "description": "Макет системы оценки имущества. Сам макет — ES-модули без сборки (app/), этот файл описывает только инструменты проверки.",
  "type": "module",
  "scripts": {
    "lint": "eslint app",
    "lint:css": "stylelint \"app/**/*.css\"",
    "lint:arch": "depcruise app --config .dependency-cruiser.cjs",
    "lint:all": "npm run lint && npm run lint:css && npm run lint:arch",
    "checks": "python tools/checks/run.py",
    "checks:changed": "python tools/checks/run.py --changed",
    "trace": "playwright show-trace",
    "codegen": "playwright codegen http://127.0.0.1:5500/app.html",
    "dead": "knip --no-progress",
    "clones": "jscpd app --min-lines 40 --min-tokens 150 --ignore \"app/vendor/**\" --reporters console",
    "graph": "depcruise app --config .dependency-cruiser.cjs --output-type mermaid --collapse \"^app/(kernel|shell|pages/[^/]+|modules/[^/]+/(oi/[^/]+|card|parts/[^/]+|data|audit)|modules/[^/]+)\" --output-to docs/arhitektura.mmd"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NMOsminnov-b-expert/inside.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "dependency-cruiser": "^18.3.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jscpd": "^5.2.0",
    "knip": "^6.35.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
