<Window x:Class="Graf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Graf.Views">
    <!-- Раскладка по Human Interface Guidelines Apple (практика графа
         dizayn-programmy-graf-proekta-po-hig-apple): сверху — панель
         инструментов в три группы (боковая панель и проект; вид; поиск,
         значки и одно выделенное действие «+»); слева — боковая панель
         (оглавление или фильтры), в центре — граф или список, справа —
         карточка записи; разделители панелей — в 1 пиксель; внизу —
         строка состояния. Без проекта — экран выбора проекта. -->
    <Grid x:Name="Root" Background="{ThemeResource HigBackground}" AllowDrop="True">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFind"/>
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="OnNew"/>
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnSave"/>
            <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="OnRecent"/>
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OnOpenFolder"/>
            <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnMode1"/>
            <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="OnMode2"/>
            <KeyboardAccelerator Modifiers="Control" Key="Number3" Invoked="OnMode3"/>
            <KeyboardAccelerator Key="F1" Invoked="OnHint"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов: три группы (HIG Toolbars — не больше трёх);
             значки без рамок; главное действие — одно, в конце, выделенное. -->
        <Grid x:Name="TopBar" Padding="8,8,12,8" BorderBrush="{ThemeResource HigSeparator}" BorderThickness="0,0,0,1" Background="{ThemeResource HigSidebar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="BtnSidebar" Padding="8,6" BorderThickness="0" Background="Transparent" ToolTipService.ToolTip="Показать или скрыть боковую панель">
                    <FontIcon Glyph="&#xE700;" FontSize="16" Foreground="{ThemeResource HigAccent}"/>
                </Button>
                <DropDownButton x:Name="ProjectBtn" BorderThickness="0" Background="Transparent" Padding="8,4" ToolTipService.ToolTip="Проект: недавние, другая папка (Ctrl+R, Ctrl+O)">
                    <TextBlock x:Name="ProjectName" Text="Проект" FontSize="15" FontWeight="SemiBold" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ProjectMenu" Placement="BottomEdgeAlignedLeft"/>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <Border x:Name="ModeHost" Grid.Column="1" Width="260" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                <AutoSuggestBox x:Name="Search" Width="260" PlaceholderText="Поиск" QueryIcon="Find" VerticalAlignment="Center"
                                CornerRadius="16" BorderThickness="0" Background="{ThemeResource HigFill}" Margin="0,0,8,0"
                                ToolTipService.ToolTip="Поиск: заголовок, ID, метка, текст (Ctrl+F)"/>
                <Button x:Name="BtnCheck" Padding="8,6" BorderThickness="0" Background="Transparent" ToolTipService.ToolTip="Проверка записей и связей">
                    <Grid>
                        <FontIcon Glyph="&#xE9D5;" FontSize="16" Foreground="{ThemeResource HigLabel}"/>
                        <Border x:Name="CheckBadge" Background="{ThemeResource HigRed}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-10,0" Visibility="Collapsed">
                            <TextBlock x:Name="CheckText" FontSize="10" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>
                <Button x:Name="BtnFit" Padding="8,6" BorderThickness="0" Background="Transparent" ToolTipService.ToolTip="Весь граф в окне (Home)">
                    <FontIcon Glyph="&#xE9A6;" FontSize="16" Foreground="{ThemeResource HigLabel}"/>
                </Button>
                <Button Padding="8,6" BorderThickness="0" Background="Transparent" ToolTipService.ToolTip="Ещё: разложить заново, выгрузка и загрузка">
                    <FontIcon Glyph="&#xE712;" FontSize="16" Foreground="{ThemeResource HigLabel}"/>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="BtnRelayout" Text="Разложить граф заново">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MiDerived" Text="Обновить граф кода и связи по смыслу">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="MiExport" Text="Выгрузить граф в файл…">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MiImport" Text="Загрузить граф из файла…">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Border x:Name="NewHost" Margin="6,0,0,0"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="Body" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="290" MinWidth="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightCol" Width="440" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Боковая панель (HIG Sidebars): сегменты «Оглавление · Фильтры»;
                 разделы — заголовками с треугольником; не больше двух уровней. -->
            <Grid x:Name="Sidebar" Background="{ThemeResource HigSidebar}" BorderBrush="{ThemeResource HigSeparator}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border x:Name="LeftSegHost" Padding="12,12,12,8"/>
                <ScrollViewer x:Name="TocPane" Grid.Row="1">
                    <StackPanel x:Name="Toc" Padding="10,4,10,24" Spacing="2"/>
                </ScrollViewer>
                <!-- Режим «Код»: модули графа кода вместо оглавления и фильтров. -->
                <ScrollViewer x:Name="CodePane" Grid.RowSpan="2" Visibility="Collapsed">
                    <StackPanel x:Name="CodeHost" Padding="12,12,12,24" Spacing="4"/>
                </ScrollViewer>
                <Grid x:Name="FilterPane" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel x:Name="FilterTop" Padding="14,2,14,10" Spacing="8"/>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel x:Name="FilterHost" Padding="12,0,12,24" Spacing="4"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <v:Splitter x:Name="LeftSplit" HorizontalAlignment="Right" Margin="0,0,-3,0" Canvas.ZIndex="5"/>

            <Grid Grid.Column="1">
                <v:GraphView x:Name="Graph"/>
                <!-- Управление видом поверх тёмного холста — «стеклянные» капсулы
                     (HIG: управление отделено от содержимого материалом). -->
                <StackPanel x:Name="GraphTools" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14">
                    <Border Background="#B81C1C1E" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="12" Padding="4">
                        <Border x:Name="DataHost" Width="150"/>
                    </Border>
                    <Border Background="#B81C1C1E" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="12" Padding="4">
                        <Border x:Name="LayoutHost" Width="320"/>
                    </Border>
                    <Border Background="#B81C1C1E" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,4,4,4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Окрестность" Foreground="#CCFFFFFF" FontSize="12" VerticalAlignment="Center"
                                       ToolTipService.ToolTip="Только выбранная запись и её соседи на 1–3 шага"/>
                            <Border x:Name="EgoHost" Width="210"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Grid x:Name="ListPane" Visibility="Collapsed" Background="{ThemeResource HigBackground}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="20,14,20,8">
                        <TextBlock Text="Сортировка" VerticalAlignment="Center" Foreground="{ThemeResource HigSecondary}" FontSize="13"/>
                        <ComboBox x:Name="SortBy" MinWidth="200" CornerRadius="8">
                            <ComboBoxItem Content="Вид записи" Tag="kind"/>
                            <ComboBoxItem Content="Заголовок" Tag="title"/>
                            <ComboBoxItem Content="Дата добавления" Tag="added"/>
                            <ComboBoxItem Content="Дата изменения" Tag="modified"/>
                        </ComboBox>
                        <Button x:Name="SortDir" Padding="10,5" BorderThickness="0" Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="SortDirIcon" Glyph="&#xE74B;" FontSize="12" Foreground="{ThemeResource HigAccent}"/>
                                <TextBlock x:Name="SortDirText" FontSize="13" Foreground="{ThemeResource HigAccent}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="1" Margin="16,0,16,16" Background="{ThemeResource HigCard}" CornerRadius="10">
                        <ListView x:Name="List" SelectionMode="Single" IsItemClickEnabled="True" Padding="0,4"/>
                    </Border>
                </Grid>
                <Border x:Name="Tip" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14" Padding="12,8"
                        CornerRadius="12" Background="#E61C1C1E" BorderBrush="#26FFFFFF" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="TipText" TextWrapping="Wrap" MaxWidth="520" Foreground="White" FontSize="13"/>
                </Border>
                <!-- Подсказка по управлению: при смене вида, потом гаснет;
                     кнопка в углу и F1 — показать снова. -->
                <Border x:Name="NavHint" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14,14,62,14" Padding="12,8"
                        CornerRadius="12" Background="#B81C1C1E" BorderBrush="#26FFFFFF" BorderThickness="1" IsHitTestVisible="False">
                    <Border.OpacityTransition><ScalarTransition Duration="0:0:0.25"/></Border.OpacityTransition>
                    <TextBlock x:Name="NavHintText" FontSize="12" Foreground="#E6FFFFFF" TextWrapping="Wrap" MaxWidth="560"/>
                </Border>
                <Button x:Name="HintBtn" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14" Width="38" Height="38" Padding="0"
                        CornerRadius="19" Background="#B81C1C1E" BorderBrush="#26FFFFFF" BorderThickness="1"
                        ToolTipService.ToolTip="Управление мышью и клавишами (F1)">
                    <FontIcon Glyph="&#xE765;" FontSize="15" Foreground="White"/>
                </Button>
            </Grid>

            <v:RecordPanel x:Name="Panel" Grid.Column="2" BorderBrush="{ThemeResource HigSeparator}" BorderThickness="1,0,0,0"/>
            <v:Splitter x:Name="RightSplit" Grid.Column="2" HorizontalAlignment="Left" Margin="-3,0,0,0" Canvas.ZIndex="5"/>
        </Grid>

        <Grid x:Name="StatusBar" Grid.Row="2" Padding="14,5" ColumnSpacing="16" BorderBrush="{ThemeResource HigSeparator}" BorderThickness="0,1,0,0" Background="{ThemeResource HigSidebar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CountText" FontSize="12" Foreground="{ThemeResource HigSecondary}"/>
            <TextBlock x:Name="GitText" Grid.Column="1" FontSize="12" Foreground="{ThemeResource HigSecondary}" TextTrimming="CharacterEllipsis"/>
            <!-- Ход обоих индексов (MainWindow.Index.cs). -->
            <StackPanel x:Name="IndexHost" Grid.Column="2" Orientation="Horizontal" Spacing="18"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{ThemeResource HigGreen}" VerticalAlignment="Center"/>
                <TextBlock x:Name="LiveText" FontSize="12" Foreground="{ThemeResource HigSecondary}" Text="слежу за изменениями"/>
            </StackPanel>
        </Grid>

        <!-- Экран выбора проекта: крупный заголовок, недавние — сгруппированным
             списком (закреплённые сверху), открыть папку, перетащить папку. -->
        <Grid x:Name="Start" Grid.RowSpan="3" Visibility="Collapsed" Background="{ThemeResource HigBackground}">
            <ScrollViewer>
                <StackPanel MaxWidth="640" Margin="32,64,32,32" Spacing="10">
                    <TextBlock Text="Граф проекта" FontSize="34" FontWeight="Bold" FontFamily="{StaticResource HigDisplayFont}"/>
                    <TextBlock x:Name="StartNote" Foreground="{ThemeResource HigSecondary}" TextWrapping="Wrap" FontSize="15"
                               Text="Выберите проект — папку, в которой лежит граф knowledge/. Последний открытый проект откроется сам при следующем запуске."/>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,12">
                        <Button x:Name="StartOpen" CornerRadius="18" Padding="18,8" BorderThickness="0" Background="{ThemeResource HigAccent}" Foreground="White">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8DA;" FontSize="14"/><TextBlock Text="Открыть папку проекта…" FontWeight="SemiBold"/></StackPanel>
                        </Button>
                        <Button x:Name="StartBack" Visibility="Collapsed" CornerRadius="18" Padding="18,8" BorderThickness="0" Background="{ThemeResource HigFill}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="14"/><TextBlock Text="Вернуться к проекту"/></StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="RecentList" Spacing="6"/>
                    <TextBlock Text="Папку можно просто перетащить в это окно." FontSize="12" Foreground="{ThemeResource HigSecondary}" Margin="14,4,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
