<Window x:Class="Graf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Graf.Views">
    <!-- Раскладка: сверху — проект, поиск и действия; слева — фильтры; в
         центре — граф (2D или 3D) или список; справа — карточка записи;
         внизу — состояние. Без проекта — экран выбора проекта. -->
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" AllowDrop="True">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFind"/>
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="OnNew"/>
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnSave"/>
            <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="OnRecent"/>
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OnOpenFolder"/>
            <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnMode1"/>
            <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="OnMode2"/>
            <KeyboardAccelerator Modifiers="Control" Key="Number3" Invoked="OnMode3"/>
            <KeyboardAccelerator Key="F1" Invoked="OnHint"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TopBar" Padding="10,8" ColumnSpacing="10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MaxWidth="520"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DropDownButton x:Name="ProjectBtn" ToolTipService.ToolTip="Проект: недавние, другая папка (Ctrl+R, Ctrl+O)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                    <TextBlock x:Name="ProjectName" Text="Проект" FontWeight="SemiBold" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="ProjectMenu" Placement="BottomEdgeAlignedLeft"/>
                </DropDownButton.Flyout>
            </DropDownButton>
            <AutoSuggestBox x:Name="Search" Grid.Column="1" PlaceholderText="Поиск: заголовок, ID, метка, текст (Ctrl+F)"
                            QueryIcon="Find" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ToggleButton x:Name="ModeGraph" IsChecked="True" CornerRadius="4,0,0,4" ToolTipService.ToolTip="Граф на плоскости (Ctrl+1)">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE9D9;" FontSize="14"/><TextBlock Text="Граф"/></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="Mode3D" CornerRadius="0" ToolTipService.ToolTip="Граф в объёме — удобен, когда узлов много (Ctrl+2)">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xF158;" FontSize="14"/><TextBlock Text="3D"/></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ModeList" CornerRadius="0,4,4,0" ToolTipService.ToolTip="Список записей (Ctrl+3)">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8FD;" FontSize="14"/><TextBlock Text="Список"/></StackPanel>
                </ToggleButton>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                <Button x:Name="BtnNew" ToolTipService.ToolTip="Новая запись (Ctrl+N)">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Text="Запись"/></StackPanel>
                </Button>
                <Button x:Name="BtnCheck" ToolTipService.ToolTip="Проверить записи и связи">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE9D5;" FontSize="14"/><TextBlock x:Name="CheckText" Text="Проверка"/></StackPanel>
                </Button>
                <Button x:Name="BtnFit" ToolTipService.ToolTip="Весь граф в окне (Home)"><FontIcon Glyph="&#xE9A6;" FontSize="14"/></Button>
                <Button x:Name="BtnRelayout" ToolTipService.ToolTip="Разложить граф заново — закреплённые узлы открепятся"><FontIcon Glyph="&#xE72C;" FontSize="14"/></Button>
                <DropDownButton ToolTipService.ToolTip="Выгрузка и загрузка графа">
                    <FontIcon Glyph="&#xE8DE;" FontSize="14"/>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="MiExport" Text="Выгрузить граф в файл…">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MiImport" Text="Загрузить граф из файла…">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <Grid x:Name="Body" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="260" MinWidth="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightCol" Width="460" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: оглавление графа и фильтры — вкладками. Оглавление —
                 запись knowledge/project/oglavlenie_grafa.py: разделы с якорями
                 (переход к записи) и метками (фильтр); раздел раскрывается
                 шевроном (практика дерева в боковой панели). -->
            <Grid RowSpacing="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <SelectorBar x:Name="LeftTabs" Margin="8,4,8,0">
                    <SelectorBarItem x:Name="TabToc" Text="Оглавление" Tag="toc"/>
                    <SelectorBarItem x:Name="TabFilters" Text="Фильтры" Tag="filters"/>
                </SelectorBar>
            <ScrollViewer x:Name="TocPane" Grid.Row="1">
                <StackPanel x:Name="Toc" Padding="10,8,10,20" Spacing="2"/>
            </ScrollViewer>
            <ScrollViewer x:Name="FilterPane" Grid.Row="1" Visibility="Collapsed">
                <StackPanel Padding="14,10,14,20" Spacing="4">
                    <TextBlock Text="ОТСЕЯННОЕ ФИЛЬТРОМ НА ГРАФЕ — ТЁМНЫМ, А НЕ СКРЫТО" FontSize="10" Opacity="0.55" TextWrapping="Wrap" CharacterSpacing="20"/>
                    <!-- Дата: готовые периоды и свой период, гистограмма правок —
                         столбик выбирается щелчком (Shift — продлить); «менялись»
                         — любая правка записи в период, не только последняя. -->
                    <TextBlock Text="ДАТА" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,8,0,2" CharacterSpacing="40"/>
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="DateModeMod" Content="Менялись" IsChecked="True" CornerRadius="4,0,0,4" Padding="10,3"/>
                        <ToggleButton x:Name="DateModeAdd" Content="Добавлены" CornerRadius="0,4,4,0" Padding="10,3"/>
                    </StackPanel>
                    <v:WrapPanel x:Name="DatePresets" Gap="6" Margin="0,6,0,0"/>
                    <Grid x:Name="DateHist" Height="58" Margin="0,8,0,0"/>
                    <TextBlock x:Name="DateHistNote" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                    <Grid ColumnSpacing="6" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <CalendarDatePicker x:Name="DateFrom" PlaceholderText="с" HorizontalAlignment="Stretch"/>
                        <CalendarDatePicker x:Name="DateTo" Grid.Column="1" PlaceholderText="по" HorizontalAlignment="Stretch"/>
                    </Grid>
                    <CheckBox x:Name="ColorByDate" Content="Цвет узла — по дате изменения" Margin="0,6,0,0"
                              ToolTipService.ToolTip="Самая свежая правка — оранжевый, самая давняя — серый"/>
                    <TextBlock x:Name="ColorLegend" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <!-- Виды связей: цвет на графе, число, показывать ли. -->
                    <TextBlock Text="СВЯЗИ" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,12,0,2" CharacterSpacing="40"/>
                    <StackPanel x:Name="EdgeKinds"/>
                    <TextBlock Text="ВИД ЗАПИСИ" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,12,0,2" CharacterSpacing="40"/>
                    <StackPanel x:Name="Folders"/>
                    <TextBlock Text="СТАТУС" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,12,0,2" CharacterSpacing="40"/>
                    <StackPanel x:Name="Statuses"/>
                    <TextBlock Text="МЕТКИ" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,12,0,2" CharacterSpacing="40"/>
                    <TextBlock Text="Отмеченные метки — все сразу у записи" FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>
                    <TextBox x:Name="TagFilter" PlaceholderText="Найти метку" Margin="0,4,0,4"/>
                    <StackPanel x:Name="Tags"/>
                    <CheckBox x:Name="Lonely" Content="Записи без связей" Margin="0,12,0,0"
                              ToolTipService.ToolTip="На графе — узлы без связей (в основном поля реестра)"/>
                    <Button x:Name="BtnReset" Content="Сбросить фильтры" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
            </Grid>
            <!-- Границы панелей тянутся мышью. -->
            <v:Splitter x:Name="LeftSplit" HorizontalAlignment="Right" Margin="0,0,-3,0" Canvas.ZIndex="5"/>

            <Grid Grid.Column="1">
                <v:GraphView x:Name="Graph"/>
                <!-- Раскладка и окрестность — поверх полотна, слева сверху (как
                     управление видом у карт): рядом с тем, на что влияют. -->
                <Border x:Name="GraphTools" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="8,6"
                        CornerRadius="8" Background="#CC131B24">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="LayoutFree" Content="Свободно" IsChecked="True" CornerRadius="4,0,0,4" Padding="10,3" FontSize="12"
                                          ToolTipService.ToolTip="Силовая раскладка всего графа"/>
                            <ToggleButton x:Name="LayoutIslands" Content="Острова" CornerRadius="0,4,4,0" Padding="10,3" FontSize="12"
                                          ToolTipService.ToolTip="Узлы одного вида записи — в своей области с подписью"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Окрестность" Foreground="#CCE6ECF2" FontSize="12" VerticalAlignment="Center"
                                       ToolTipService.ToolTip="Только выбранная запись и её соседи на 1–3 шага, кольцами"/>
                            <StackPanel x:Name="EgoButtons" Orientation="Horizontal"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Список: сверху сортировка — по чему и в какую сторону (практика
                     GitLab: выпадающий список и кнопка направления); даты — в
                     строке, чтобы порядок не шёл по невидимому признаку. -->
                <Grid x:Name="ListPane" Visibility="Collapsed" RowSpacing="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="14,8,14,0">
                        <TextBlock Text="Сортировка" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
                        <ComboBox x:Name="SortBy" MinWidth="200">
                            <ComboBoxItem Content="Вид записи" Tag="kind"/>
                            <ComboBoxItem Content="Заголовок" Tag="title"/>
                            <ComboBoxItem Content="Дата добавления" Tag="added"/>
                            <ComboBoxItem Content="Дата изменения" Tag="modified"/>
                        </ComboBox>
                        <Button x:Name="SortDir" Padding="8,5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="SortDirIcon" Glyph="&#xE74B;" FontSize="12"/>
                                <TextBlock x:Name="SortDirText" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ListView x:Name="List" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True"/>
                </Grid>
                <Border x:Name="Tip" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="10,6"
                        CornerRadius="6" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="TipText" TextWrapping="Wrap" MaxWidth="520"/>
                </Border>
                <!-- Подсказка по управлению: при смене вида, потом гаснет;
                     кнопка в углу и F1 — показать снова. -->
                <Border x:Name="NavHint" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12,12,56,12" Padding="10,6"
                        CornerRadius="6" Background="#CC131B24" IsHitTestVisible="False">
                    <Border.OpacityTransition><ScalarTransition Duration="0:0:0.25"/></Border.OpacityTransition>
                    <TextBlock x:Name="NavHintText" FontSize="11" Foreground="#E6E6ECF2" TextWrapping="Wrap" MaxWidth="560"/>
                </Border>
                <Button x:Name="HintBtn" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Width="36" Height="32" Padding="0"
                        ToolTipService.ToolTip="Управление мышью и клавишами (F1)">
                    <FontIcon Glyph="&#xE765;" FontSize="14"/>
                </Button>
            </Grid>

            <v:RecordPanel x:Name="Panel" Grid.Column="2"/>
            <v:Splitter x:Name="RightSplit" Grid.Column="2" HorizontalAlignment="Left" Margin="-3,0,0,0" Canvas.ZIndex="5"/>
        </Grid>

        <Grid x:Name="StatusBar" Grid.Row="2" Padding="14,4" ColumnSpacing="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CountText" FontSize="12" Opacity="0.75"/>
            <TextBlock x:Name="GitText" Grid.Column="1" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="SeaGreen" VerticalAlignment="Center"/>
                <TextBlock x:Name="LiveText" FontSize="12" Opacity="0.75" Text="слежу за изменениями"/>
            </StackPanel>
        </Grid>

        <!-- Экран выбора проекта: недавние (закреплённые сверху), открыть
             папку, перетащить папку в окно. -->
        <Grid x:Name="Start" Grid.RowSpan="3" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <ScrollViewer>
                <StackPanel MaxWidth="760" Margin="32,56,32,32" Spacing="18">
                    <TextBlock Text="Граф проекта" FontSize="32" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StartNote" Opacity="0.7" TextWrapping="Wrap"
                               Text="Выберите проект — папку, в которой лежит граф knowledge/. Последний открытый проект откроется сам при следующем запуске."/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="StartOpen" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8DA;" FontSize="14"/><TextBlock Text="Открыть папку проекта…"/></StackPanel>
                        </Button>
                        <Button x:Name="StartBack" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="14"/><TextBlock Text="Вернуться к проекту"/></StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Папку можно просто перетащить в это окно." FontSize="12" Opacity="0.55"/>
                    <TextBlock Text="НЕДАВНИЕ" FontSize="11" FontWeight="SemiBold" Opacity="0.6" CharacterSpacing="40" Margin="0,10,0,0"/>
                    <StackPanel x:Name="RecentList" Spacing="6"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
