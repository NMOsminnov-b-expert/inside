<Application x:Class="Graf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Оформление по Human Interface Guidelines Apple (практика графа
         dizayn-programmy-graf-proekta-po-hig-apple): цвета — значения iOS для
         светлой и тёмной темы, акцент — системный синий, шрифт — Segoe UI
         Variable (системный шрифт Windows, как SF у Apple). Кисти Hig* —
         в Views/Hig.cs и разметке; стандартные кисти WinUI переопределены
         теми же значениями, чтобы встроенные элементы не выбивались. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="HigDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
            <x:Double x:Key="ControlContentThemeFontSize">14</x:Double>
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#007AFF</Color>
                    <Color x:Key="SystemAccentColorLight1">#3395FF</Color>
                    <Color x:Key="SystemAccentColorLight2">#66AFFF</Color>
                    <Color x:Key="SystemAccentColorDark1">#0062CC</Color>
                    <Color x:Key="SystemAccentColorDark2">#004A99</Color>
                    <SolidColorBrush x:Key="HigBackground" Color="#F2F2F7"/>
                    <SolidColorBrush x:Key="HigSidebar" Color="#EBEBF0"/>
                    <SolidColorBrush x:Key="HigCard" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="HigCardPressed" Color="#E5E5EA"/>
                    <SolidColorBrush x:Key="HigFill" Color="#E3E3E8"/>
                    <SolidColorBrush x:Key="HigSeparator" Color="#D1D1D6"/>
                    <SolidColorBrush x:Key="HigLabel" Color="#000000"/>
                    <SolidColorBrush x:Key="HigSecondary" Color="#8A8A8E"/>
                    <SolidColorBrush x:Key="HigTertiary" Color="#C4C4C7"/>
                    <SolidColorBrush x:Key="HigAccent" Color="#007AFF"/>
                    <SolidColorBrush x:Key="HigAccentSoft" Color="#1F007AFF"/>
                    <SolidColorBrush x:Key="HigRed" Color="#FF3B30"/>
                    <SolidColorBrush x:Key="HigOrange" Color="#FF9500"/>
                    <SolidColorBrush x:Key="HigGreen" Color="#34C759"/>
                    <SolidColorBrush x:Key="HigSegmentThumb" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F2F2F7"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#0A84FF</Color>
                    <Color x:Key="SystemAccentColorLight1">#3D9DFF</Color>
                    <Color x:Key="SystemAccentColorLight2">#70B6FF</Color>
                    <Color x:Key="SystemAccentColorDark1">#0069CC</Color>
                    <Color x:Key="SystemAccentColorDark2">#004F99</Color>
                    <SolidColorBrush x:Key="HigBackground" Color="#000000"/>
                    <SolidColorBrush x:Key="HigSidebar" Color="#161618"/>
                    <SolidColorBrush x:Key="HigCard" Color="#1C1C1E"/>
                    <SolidColorBrush x:Key="HigCardPressed" Color="#2C2C2E"/>
                    <SolidColorBrush x:Key="HigFill" Color="#2C2C2E"/>
                    <SolidColorBrush x:Key="HigSeparator" Color="#38383A"/>
                    <SolidColorBrush x:Key="HigLabel" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="HigSecondary" Color="#98989F"/>
                    <SolidColorBrush x:Key="HigTertiary" Color="#5A5A5F"/>
                    <SolidColorBrush x:Key="HigAccent" Color="#0A84FF"/>
                    <SolidColorBrush x:Key="HigAccentSoft" Color="#330A84FF"/>
                    <SolidColorBrush x:Key="HigRed" Color="#FF453A"/>
                    <SolidColorBrush x:Key="HigOrange" Color="#FF9F0A"/>
                    <SolidColorBrush x:Key="HigGreen" Color="#30D158"/>
                    <SolidColorBrush x:Key="HigSegmentThumb" Color="#636366"/>
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#000000"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
