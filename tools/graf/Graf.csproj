<Project Sdk="Microsoft.NET.Sdk">

  <!-- «Граф проекта»: просмотр и правка графа knowledge/ (tools/graf/README.md).
       WinUI 3 без упаковки, Windows App Runtime внутри: у коллег ничего не
       ставится и прав администратора не нужно. Рисование графа — Win2D. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Graf</RootNamespace>
    <AssemblyName>Graf</AssemblyName>
    <Product>Граф проекта</Product>
    <Version>0.1.0</Version>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.*" />
  </ItemGroup>

  <!-- dotnet publish без упаковки не кладёт в выпуск ресурсы разметки
       (Graf.pri, *.xbf) — окно падает при запуске в Microsoft.UI.Xaml.dll
       (0xc000027b). Докладываем их из папки сборки. -->
  <Target Name="CopyXamlResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <XamlRes Include="$(OutDir)$(AssemblyName).pri;$(OutDir)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(XamlRes)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
