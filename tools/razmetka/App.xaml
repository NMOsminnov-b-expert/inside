<Application x:Class="Razmetka.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Light">
    <!-- Оформление (практика interfeys-razmetki-dokumentov-klavishi-palitra-
         komand-inspektor-po-vyb, 29.09.2026): основа — встроенная тема Windows 11
         (ThemeMode, Fluent) для полей, списков, меню и полос прокрутки; поверх —
         свои кисти и стили по размерам Fluent 2: скругление 4 у элементов, 8 у
         всплывающих панелей, шаг отступов 4, Segoe UI Variable.
         Кисти: Ground — окно, Panel — боковые панели, Card — карточки и
         всплывающие панели, Line — разделители, Ink / Muted / Faint — текст по
         важности, Accent — выбор и главное действие. -->
    <Application.Resources>
        <SolidColorBrush x:Key="Ground" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="Panel" Color="#FAFAFB"/>
        <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Line" Color="#E3E5E9"/>
        <SolidColorBrush x:Key="LineStrong" Color="#CDD1D8"/>
        <SolidColorBrush x:Key="Ink" Color="#1B1F24"/>
        <SolidColorBrush x:Key="Muted" Color="#5E6672"/>
        <SolidColorBrush x:Key="Faint" Color="#8C939E"/>
        <SolidColorBrush x:Key="Hover" Color="#EEF0F3"/>
        <SolidColorBrush x:Key="Pressed" Color="#E4E7EB"/>
        <SolidColorBrush x:Key="Accent" Color="#0067C0"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1975C5"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#E6F0FA"/>
        <SolidColorBrush x:Key="AccentText" Color="#005299"/>
        <SolidColorBrush x:Key="Danger" Color="#C42B1C"/>
        <SolidColorBrush x:Key="DangerSoft" Color="#FDE7E9"/>
        <SolidColorBrush x:Key="Warn" Color="#9D5D00"/>
        <SolidColorBrush x:Key="WarnSoft" Color="#FFF4CE"/>
        <SolidColorBrush x:Key="Ok" Color="#0F7B0F"/>
        <SolidColorBrush x:Key="Dark" Color="#E61F2328"/>
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Резкость: текст — по пикселям экрана (Display), а не «идеальной»
             формы — она мылит мелкий шрифт; размеры и границы — по целым
             точкам. Разрешение экрана — по каждому монитору (app.manifest). -->
        <Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxWidth" Value="360"/>
        </Style>

        <!-- Кнопка без фона: панели, строки, нижняя панель инструментов. Фокус
             клавиатуры у неё не остаётся — одиночные клавиши полотна после
             щелчка по кнопке продолжают работать. -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Pressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Главное действие: одно на панель или карточку. -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка с рамкой: второстепенное действие рядом с главным. -->
        <Style x:Key="OutlineBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Инструмент нижней панели: значок, буква клавиши в углу, включённый —
             с акцентом (Excalidraw: клавиша напечатана на кнопке). -->
        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6">
                            <Grid>
                                <TextBlock x:Name="ic" Text="{TemplateBinding Content}" FontFamily="{StaticResource IconFont}" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock x:Name="k" Text="{TemplateBinding Tag}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Faint}"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="ic" Property="Foreground" Value="White"/>
                                <Setter TargetName="k" Property="Foreground" Value="#CCFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Глаз и замок в списке слоёв: включённое — ярко, выключенное — бледно. -->
        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="4">
                            <TextBlock x:Name="t" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" Opacity="0.35"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="t" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Margin" Value="16,14,12,6"/>
        </Style>

        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="6,8"/>
            <Setter Property="Background" Value="{DynamicResource Line}"/>
        </Style>

        <!-- Список без собственной рамки и подсветки: строки рисуют выбор сами. -->
        <Style x:Key="PlainList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Application.Resources>
</Application>
