<Window x:Class="Razmetka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:Razmetka.Editor"
        Title="Разметка документов" Width="1500" Height="920" MinWidth="980" MinHeight="600"
        Background="{StaticResource Ground}" AllowDrop="True">
    <!-- Раскладка: панель инструментов; слева главы и развороты, в центре
         полотно, справа слои и свойства выбранного; внизу строка состояния. -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <WrapPanel Margin="8,6">
                <Button Style="{StaticResource ToolBtn}" x:Name="BtnNew" ToolTip="Новый проект — выбрать пустую папку">Новый</Button>
                <Button Style="{StaticResource ToolBtn}" x:Name="BtnOpen" ToolTip="Открыть папку проекта (Ctrl+O)">Открыть</Button>
                <Button Style="{StaticResource PrimaryBtn}" x:Name="BtnSave" ToolTip="Сохранить (Ctrl+S)">Сохранить</Button>
                <Border Style="{StaticResource Sep}"/>
                <Button Style="{StaticResource ToolBtn}" x:Name="BtnAddImage" ToolTip="Добавить фото или скан из файла; можно перетащить файлы на окно или вставить Ctrl+V">Добавить фото</Button>
                <Button Style="{StaticResource ToolBtn}" x:Name="BtnNote" ToolTip="Заметка: щелчок по полотну ставит булавку с вопросом или пояснением (N)">Заметка</Button>
                <Button Style="{StaticResource ToolBtn}" x:Name="BtnNewLink" ToolTip="Новая связь: обвести графу на документе, затем поле на снимке системы (L)">Новая связь</Button>
                <Border Style="{StaticResource Sep}"/>
                <Button Style="{StaticResource ToolBtn}" x:Name="BtnUndo" ToolTip="Отменить (Ctrl+Z)">↶</Button>
                <Button Style="{StaticResource ToolBtn}" x:Name="BtnRedo" ToolTip="Повторить (Ctrl+Y)">↷</Button>
                <Border Style="{StaticResource Sep}"/>
                <Button Style="{StaticResource ToolBtn}" x:Name="BtnZoomOut" ToolTip="Мельче (Ctrl+−)">−</Button>
                <TextBlock x:Name="ZoomText" VerticalAlignment="Center" MinWidth="48" TextAlignment="Center" Foreground="{StaticResource Muted}">100 %</TextBlock>
                <Button Style="{StaticResource ToolBtn}" x:Name="BtnZoomIn" ToolTip="Крупнее (Ctrl++)">+</Button>
                <Button Style="{StaticResource ToolBtn}" x:Name="BtnFit" ToolTip="Весь разворот в окне (Ctrl+0)">По окну</Button>
                <Button Style="{StaticResource ToolBtn}" x:Name="BtnLens" ToolTip="Лупа: участок под курсором втрое крупнее (M)">Лупа</Button>
                <Border Style="{StaticResource Sep}"/>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="4,0,6,0">Поиск</TextBlock>
                <TextBox x:Name="SearchBox" Width="170" VerticalContentAlignment="Center" Padding="4,3"
                         ToolTip="Графа документа или поле системы по всему проекту; Enter — следующая (Ctrl+F)"/>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="10,0,6,0">Блок</TextBlock>
                <ComboBox x:Name="FilterBox" Width="210" ToolTip="Блок системы: ярко — только его связи"/>
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,4">
                <TextBlock x:Name="SizeText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="290" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- Главы и развороты -->
            <Border Grid.Column="0" Background="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelTitle}">ГЛАВЫ И РАЗВОРОТЫ</TextBlock>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="8,0,8,0">
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="4,0,4,0">Таблица</TextBlock>
                        <Button Style="{StaticResource ToolBtn}" x:Name="BtnLayoutBelow" ToolTip="Таблица связей под картинками во всю ширину">снизу</Button>
                        <Button Style="{StaticResource ToolBtn}" x:Name="BtnLayoutRight" ToolTip="Таблица связей колонкой справа">справа</Button>
                    </WrapPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="8">
                        <Button Style="{StaticResource ToolBtn}" x:Name="BtnAddChapter" ToolTip="Новая глава — новый документ">+ Глава</Button>
                        <Button Style="{StaticResource ToolBtn}" x:Name="BtnAddSheet" ToolTip="Новый разворот в выбранной главе">+ Разворот</Button>
                        <Button Style="{StaticResource ToolBtn}" x:Name="BtnDelSheet" ToolTip="Удалить выбранный разворот или главу">Удалить</Button>
                    </WrapPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,4">
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11">Название</TextBlock>
                        <TextBox x:Name="TreeTitle" Margin="0,2,0,0" Padding="4,3"/>
                        <TextBlock x:Name="TreeSubLabel" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0">Страница</TextBlock>
                        <TextBox x:Name="TreeSub" Margin="0,2,0,0" Padding="4,3"/>
                    </StackPanel>
                    <TreeView x:Name="Tree" BorderThickness="0" Margin="4,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource Line}" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Полотно -->
            <Grid Grid.Column="2">
                <ed:SheetView x:Name="View"/>
                <!-- Подсказки связей: по щелчку на стрелку, номер или строку
                     таблицы. Закреплённые стоят у номера связи и едут вместе с
                     полотном. -->
                <Canvas x:Name="Pops" ClipToBounds="True"/>
                <Border x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource Panel}"
                        CornerRadius="10" Padding="24,18" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel MaxWidth="420">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap">Проект не открыт</TextBlock>
                        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap">
                            «Новый» — выбрать пустую папку для проекта, «Открыть» — папку, где лежит razmetka.json.
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border x:Name="LinkBar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"
                        Background="{StaticResource Ink}" CornerRadius="8" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="LinkBarText" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource PrimaryBtn}" x:Name="BtnLinkCancel">Отмена</Button>
                    </StackPanel>
                </Border>
                <Border x:Name="CropBar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"
                        Background="{StaticResource Ink}" CornerRadius="8" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0">
                            Обрезка: ручки — край, внутри — сдвиг картинки. Enter или Esc — готово
                        </TextBlock>
                        <Button Style="{StaticResource ToolBtn}" Foreground="White" x:Name="BtnCropReset">Сбросить обрезку</Button>
                        <Button Style="{StaticResource PrimaryBtn}" x:Name="BtnCropDone">Готово</Button>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" Background="{StaticResource Line}" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Слои и свойства -->
            <Border Grid.Column="4" Background="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelTitle}">СЛОИ · СВЕРХУ ВНИЗ</TextBlock>
                    <StackPanel DockPanel.Dock="Bottom" x:Name="NoteProps" Margin="12,6,12,12" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PanelTitle}" Margin="0,4,0,6">ЗАМЕТКА</TextBlock>
                        <TextBox x:Name="NoteText" Padding="4,3" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="90"/>
                        <TextBlock x:Name="NoteMeta" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,6"/>
                        <WrapPanel>
                            <Button Style="{StaticResource ToolBtn}" x:Name="BtnNoteDel" ToolTip="Удалить заметку (Delete)">Удалить</Button>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" x:Name="LinkProps" Margin="12,6,12,12" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PanelTitle}" Margin="0,4,0,6">СВЯЗЬ</TextBlock>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Left" Width="64" Margin="0,0,8,0">
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="11" ToolTip="Номер на стрелке и в таблице; остальные сдвинутся">Номер</TextBlock>
                                <TextBox x:Name="LinkN" Margin="0,2,0,0" Padding="4,3" TextAlignment="Right"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="11">Тип связи</TextBlock>
                                <ComboBox x:Name="LinkKindBox" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="LinkDocLabel" Foreground="{StaticResource Muted}" FontSize="11">Графа документа</TextBlock>
                        <TextBox x:Name="LinkDoc" Margin="0,2,0,6" Padding="4,3" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="40"/>
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11">Блок и поле системы</TextBlock>
                        <TextBox x:Name="LinkSys" Margin="0,2,0,6" Padding="4,3" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="40"/>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Left" Width="128" Margin="0,0,8,0">
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="11" ToolTip="Из какой стороны рамки на документе выходит стрелка">Выход стрелки</TextBlock>
                                <ComboBox x:Name="LinkSrcSide" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="11" ToolTip="В какую сторону рамки на снимке входит стрелка">Вход стрелки</TextBlock>
                                <ComboBox x:Name="LinkTgtSide" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" ToolTip="Адрес страницы макета или документа — откроется из экспорта">Ссылка</TextBlock>
                        <TextBox x:Name="LinkUrl" Margin="0,2,0,8" Padding="4,3"/>
                        <WrapPanel>
                            <Button Style="{StaticResource ToolBtn}" x:Name="BtnReroute" ToolTip="Проложить стрелку заново в обход остальных">Переложить</Button>
                            <Button Style="{StaticResource ToolBtn}" x:Name="BtnLinkDup" ToolTip="Копия связи: рамки ниже на свою высоту (Ctrl+D)">Копия</Button>
                            <Button Style="{StaticResource ToolBtn}" x:Name="BtnLinkDel" ToolTip="Удалить связь и её рамки (Delete)">Удалить</Button>
                        </WrapPanel>
                        <TextBlock x:Name="LinkHistTitle" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,2">Изменения связи</TextBlock>
                        <TextBlock x:Name="LinkHist" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SeeAlsoTitle" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,2">То же поле в других разворотах</TextBlock>
                        <WrapPanel x:Name="SeeAlso"/>
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0">
                            Рамки: край — перенос, углы — размер. Стрелка: отрезок — тянуть; двойной щелчок по отрезку — излом, по углу — выпрямить.
                        </TextBlock>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" x:Name="Props" Margin="12,6,12,12">
                        <TextBlock Style="{StaticResource PanelTitle}" Margin="0,4,0,6">ВЫБРАННЫЙ СЛОЙ</TextBlock>
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11">Название слоя</TextBlock>
                        <TextBox x:Name="PropName" Margin="0,2,0,6" Padding="4,3"/>
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11">Подпись над картинкой</TextBlock>
                        <TextBox x:Name="PropCaption" Margin="0,2,0,8" Padding="4,3"/>
                        <WrapPanel>
                            <Button Style="{StaticResource ToolBtn}" x:Name="BtnCrop" ToolTip="Обрезать (двойной щелчок по фото)">Обрезать</Button>
                            <Button Style="{StaticResource ToolBtn}" x:Name="BtnReplace" ToolTip="Заменить картинку, обрезка и место сохраняются">Заменить</Button>
                            <Button Style="{StaticResource ToolBtn}" x:Name="BtnDup" ToolTip="Копия со сдвигом (Ctrl+D)">Копия</Button>
                            <Button Style="{StaticResource ToolBtn}" x:Name="BtnDelete" ToolTip="Удалить (Delete)">Удалить</Button>
                        </WrapPanel>
                        <WrapPanel x:Name="TableTools" Margin="0,4,0,0" Visibility="Collapsed">
                            <Button Style="{StaticResource ToolBtn}" x:Name="BtnTableSplit" ToolTip="Разделить таблицу по строке выбранной связи или пополам">Разделить</Button>
                            <Button Style="{StaticResource ToolBtn}" x:Name="BtnTableMerge" ToolTip="Слить со следующей частью">Слить</Button>
                        </WrapPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Style="{StaticResource ToolBtn}" x:Name="BtnTop" ToolTip="Наверх (Ctrl+Shift+])">Наверх</Button>
                            <Button Style="{StaticResource ToolBtn}" x:Name="BtnUp" ToolTip="Выше (Ctrl+])">Выше</Button>
                            <Button Style="{StaticResource ToolBtn}" x:Name="BtnDown" ToolTip="Ниже (Ctrl+[)">Ниже</Button>
                            <Button Style="{StaticResource ToolBtn}" x:Name="BtnBottom" ToolTip="Вниз (Ctrl+Shift+[)">Вниз</Button>
                        </WrapPanel>
                    </StackPanel>
                    <ListBox x:Name="Layers" BorderThickness="0" Margin="4,0" SelectionMode="Extended" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
