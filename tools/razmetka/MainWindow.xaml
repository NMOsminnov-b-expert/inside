<Window x:Class="Razmetka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:Razmetka.Editor"
        xmlns:ui="clr-namespace:Razmetka.Ui"
        Title="Разметка документов" Icon="Assets/razmetka.ico" Width="1500" Height="920" MinWidth="980" MinHeight="600"
        Background="{StaticResource Ground}" AllowDrop="True">
    <!-- Раскладка (практика interfeys-razmetki-dokumentov-klavishi-palitra-komand-
         inspektor-po-vyb; Figma UI3): шапка — проект, где я, поиск по связям,
         сохранение, проверка, экспорт, палитра команд; слева — развороты и слои
         текущего; в центре — полотно, инструменты — плавающей панелью внизу по
         центру; справа — инспектор выбранного; внизу — строка состояния.
         Боковые панели закреплены и тянутся; Ctrl+\ — только полотно. -->
    <Grid Background="{StaticResource Ground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ProjectBtn" Style="{StaticResource ToolBtn}" Padding="8,4" VerticalAlignment="Center" ToolTip="Проект: новый, открыть, недавние, экспорт">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/razmetka.ico" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ProjectTitle" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis">Разметка документов</TextBlock>
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="8,2,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Button>
                <!-- Где я: глава › разворот; щелчок — перейти к другому (Ctrl+P). -->
                <Button x:Name="CrumbBtn" Grid.Column="1" Style="{StaticResource ToolBtn}" Padding="8,4" Margin="2,0,12,0" HorizontalAlignment="Left"
                        HorizontalContentAlignment="Left" VerticalAlignment="Center" ToolTip="Перейти к другому развороту — Ctrl+P">
                    <TextBlock x:Name="Crumbs" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                </Button>

                <!-- Поиск по связям: графа документа или поле системы по всему
                     проекту; Enter — следующая, Shift+Enter — предыдущая. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="SearchHost" Width="300" Height="32" CornerRadius="4" Background="{StaticResource Card}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Foreground="{StaticResource Faint}" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">Графа или поле системы</TextBlock>
                            <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="0" VerticalContentAlignment="Center"
                                     ToolTip="Поиск по связям всего проекта: Enter — следующая, Shift+Enter — предыдущая, Esc — к полотну (Ctrl+F)"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0">
                                <TextBlock x:Name="SearchCount" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                <Border x:Name="SearchKbd" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ComboBox x:Name="FilterBox" Width="190" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Блок системы: ярко — только его связи, остальные бледнеют"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="PaletteBtn" Style="{StaticResource ToolBtn}" Padding="8,4" ToolTip="Все команды, развороты и связи — Ctrl+K">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Border x:Name="PaletteKbd" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CheckBtn" Style="{StaticResource ToolBtn}" Padding="8,4" Margin="2,0,0,0" ToolTip="Проверка разметки — F8 к следующему замечанию">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CheckIcon" Text="&#xE762;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="CheckLabel" VerticalAlignment="Center">Проверка</TextBlock>
                            <Border x:Name="CheckBadge" CornerRadius="9" Padding="6,0,6,1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="CheckCount" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportBtn" Style="{StaticResource ToolBtn}" Padding="8,4" Margin="2,0,0,0" ToolTip="Экспорт: HTML-страница, таблица Excel, разворот картинкой — Ctrl+E">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72D;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ExportLabel" VerticalAlignment="Center">Экспорт</TextBlock>
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource Sep}" Height="24" Margin="10,0"/>
                    <!-- Сохранение: всё сохранено — тихая надпись; есть правки —
                         кнопка (GitLab saving and feedback: состояние рядом с
                         содержимым, не всплывающим сообщением). -->
                    <TextBlock x:Name="SaveState" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,8,0"/>
                    <Button x:Name="SaveBtn" Style="{StaticResource PrimaryBtn}" ToolTip="Сохранить проект — Ctrl+S">Сохранить</Button>
                    <Button x:Name="HelpBtn" Style="{StaticResource ToolBtn}" Padding="8,4" Margin="6,0,0,0" ToolTip="Клавиши — F1">
                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeft" Width="272" MinWidth="0"/>
                <ColumnDefinition x:Name="ColLeftSplit" Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition x:Name="ColRightSplit" Width="Auto"/>
                <ColumnDefinition x:Name="ColRight" Width="316" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- Развороты и слои текущего разворота -->
            <Border x:Name="LeftPane" Background="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="120"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="LayersRow" Height="230" MinHeight="80"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="16,10,8,4">
                        <Button x:Name="NavAddBtn" DockPanel.Dock="Right" Style="{StaticResource ToolBtn}" Padding="7,4" ToolTip="Добавить: разворот, главу, документ из PDF">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                        </Button>
                        <TextBlock Text="Развороты" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="Nav" Grid.Row="1" Style="{StaticResource PlainList}" Margin="6,0,6,6"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"/>
                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>
                    <DockPanel Grid.Row="3" Margin="16,4,8,4">
                        <TextBlock x:Name="LayersCount" DockPanel.Dock="Right" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Слои" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="Сверху вниз, как на полотне"/>
                    </DockPanel>
                    <ListBox x:Name="Layers" Grid.Row="4" Style="{StaticResource PlainList}" Margin="6,0,6,8" SelectionMode="Extended" HorizontalContentAlignment="Stretch"/>
                    <Border Grid.Row="0" Grid.RowSpan="5" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <GridSplitter x:Name="LeftSplit" Grid.Column="1" Width="4" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Полотно -->
            <Grid x:Name="CanvasArea" Grid.Column="2">
                <ed:SheetView x:Name="View"/>
                <Canvas x:Name="Pops" ClipToBounds="True"/>

                <!-- Пустой разворот: с чего начать. -->
                <Border x:Name="SheetHint" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                        Background="{StaticResource Card}" CornerRadius="8" Padding="28,24" BorderBrush="{StaticResource LineStrong}" BorderThickness="1.5">
                    <StackPanel MaxWidth="460">
                        <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="{StaticResource Accent}" HorizontalAlignment="Left"/>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" Foreground="{StaticResource Ink}">Разворот пуст</TextBlock>
                        <TextBlock Margin="0,6,0,14" Foreground="{StaticResource Muted}" TextWrapping="Wrap">
                            Перетащите сюда скан или снимок экрана, вставьте картинку из буфера обмена или возьмите страницы из PDF.
                        </TextBlock>
                        <WrapPanel x:Name="SheetHintActions"/>
                    </StackPanel>
                </Border>

                <!-- Проект не открыт: недавние, новый, открыть. -->
                <Border x:Name="StartScreen" Background="{StaticResource Ground}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ink}">Разметка документов</TextBlock>
                            <TextBlock Margin="0,4,0,20" Foreground="{StaticResource Muted}" TextWrapping="Wrap">
                                Страницы документа и снимки системы на одном развороте: рамки на графах, стрелки к полям, таблица связей.
                            </TextBlock>
                            <WrapPanel x:Name="StartActions" Margin="0,0,0,20"/>
                            <TextBlock x:Name="RecentTitle" FontWeight="SemiBold" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6">Недавние</TextBlock>
                            <Border CornerRadius="8" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                <StackPanel x:Name="RecentList" Margin="4"/>
                            </Border>
                            <TextBlock Margin="0,14,0,0" Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap">
                                Можно перетащить на окно папку проекта — она откроется.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Режим (новая связь, обрезка, подгонка по точкам, заметка):
                     шаг, что сделать сейчас, как выйти. -->
                <Border x:Name="ModeBar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"
                        Background="{StaticResource Dark}" CornerRadius="8" Padding="6,6,6,6">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="ModeStep" CornerRadius="4" Background="{StaticResource Accent}" Padding="8,2,8,3" Margin="2,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ModeStepText" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <TextBlock x:Name="ModeText" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel x:Name="ModeActions" Orientation="Horizontal"/>
                    </StackPanel>
                </Border>

                <!-- Инструменты — внизу по центру (Figma UI3); буква клавиши на
                     кнопке (Excalidraw). -->
                <!-- Тень — у подложки (ToolbarShadow): эффект на самой панели
                     мылит значки и текст внутри. -->
                <Border x:Name="ToolbarShadow" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Visibility="{Binding Visibility, ElementName=Toolbar}"
                        Background="{StaticResource Card}" CornerRadius="8" IsHitTestVisible="False"
                        Width="{Binding ActualWidth, ElementName=Toolbar}" Height="{Binding ActualHeight, ElementName=Toolbar}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.16" Direction="270"/>
                    </Border.Effect>
                </Border>
                <Border x:Name="Toolbar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Visibility="Collapsed"
                        Background="{StaticResource Card}" CornerRadius="8" Padding="4" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="TSelect" Style="{StaticResource ToolToggle}" Content="&#xE8B0;" Tag="V"/>
                        <ToggleButton x:Name="THand" Style="{StaticResource ToolToggle}" Content="&#xE7C2;" Tag="H"/>
                        <ToggleButton x:Name="TLink" Style="{StaticResource ToolToggle}" Content="&#xE71B;" Tag="L"/>
                        <ToggleButton x:Name="TNote" Style="{StaticResource ToolToggle}" Content="&#xE70B;" Tag="N"/>
                        <ToggleButton x:Name="TLens" Style="{StaticResource ToolToggle}" Content="&#xE71E;" Tag="M"/>
                        <Border Style="{StaticResource Sep}"/>
                        <Button x:Name="TAdd" Style="{StaticResource ToolBtn}" Width="40" Height="40" MinHeight="0" Padding="0">
                            <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                        </Button>
                        <Border x:Name="SepUndo" Style="{StaticResource Sep}"/>
                        <Button x:Name="TUndo" Style="{StaticResource ToolBtn}" Width="40" Height="40" MinHeight="0" Padding="0">
                            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                        </Button>
                        <Button x:Name="TRedo" Style="{StaticResource ToolBtn}" Width="40" Height="40" MinHeight="0" Padding="0">
                            <TextBlock Text="&#xE7A6;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                        </Button>
                        <Border x:Name="SepZoom" Style="{StaticResource Sep}"/>
                        <Button x:Name="TZoomOut" Style="{StaticResource ToolBtn}" Width="32" Height="40" MinHeight="0" Padding="0">
                            <TextBlock Text="&#xE738;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                        </Button>
                        <Button x:Name="TZoom" Style="{StaticResource ToolBtn}" Height="40" MinHeight="0" MinWidth="56" Padding="6,0">
                            <TextBlock x:Name="ZoomText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}">100 %</TextBlock>
                        </Button>
                        <Button x:Name="TZoomIn" Style="{StaticResource ToolBtn}" Width="32" Height="40" MinHeight="0" Padding="0">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter x:Name="RightSplit" Grid.Column="3" Width="4" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
            <!-- Инспектор: свойства выбранного; без выбора — разворот и глава. -->
            <Border x:Name="RightPane" Grid.Column="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <ScrollViewer x:Name="InspScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="Insp" Margin="0,0,0,24"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Строка состояния: слева — что сделает щелчок или что сделано,
             справа — выбранное и размер картинок. -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,0,16,0">
                <TextBlock x:Name="SizeText" DockPanel.Dock="Right" Foreground="{StaticResource Faint}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="SelText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <ui:Cheatsheet x:Name="Cheat" Grid.RowSpan="3"/>
        <ui:Palette x:Name="Pal" Grid.RowSpan="3"/>
    </Grid>
</Window>
