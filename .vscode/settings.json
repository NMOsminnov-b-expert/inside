{
  // Прокси Live Server к порталу Кадастра.
  //
  // Портал не отдаёт Access-Control-Allow-Origin, поэтому напрямую из браузера
  // его ответ прочитать нельзя. Live Server умеет проксировать сам: запрос на
  // /cadastre/searchAddrResult.do уходит на портал, а для страницы остаётся
  // тем же источником — CORS не при чём.
  //
  // Отдельный процесс (tools/cadastre/proxy.py) после этого не нужен: он
  // остаётся запасным вариантом для тех, кто открывает макет не через Live
  // Server.
  //
  // Настройка применяется при СТАРТЕ Live Server: если он уже запущен, его
  // нужно остановить и запустить снова.
  // Изменения этих папок макет не перезагружают: там инструменты
  // (программы «Граф проекта», «Разметка документов», сборщики документов)
  // и графы — знаний и индексы поиска. Они пишутся на диск постоянно, а
  // перезагрузка страницы посреди проверки сбивает её (просьба пользователя
  // 29.09.2026). Первые четыре строки — значения Live Server по умолчанию: список
  // заменяет их, а не дополняет. Применяется при старте Live Server.
  "liveServer.settings.ignoreFiles": [
    ".vscode/**",
    "**/*.scss",
    "**/*.sass",
    "**/*.ts",
    "**/*.map",
    "tools/**",
    "knowledge/**",
    ".codegraph/**",
    ".graf/**"
  ],
  "liveServer.settings.proxy": {
    "enable": true,
    "baseUri": "/cadastre",
    "proxyUri": "https://cadastre.kg/svc-portal/map/"
  }
}
